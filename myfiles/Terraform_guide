========================================DAY 1 +++++++++++++++++++++++++++++++++++++++
main.tf
terraform {
  required_providers {
    aws = {
        source = "hashicorp/aws"
        version = "~> 6.0"
    }
  }
}
provider "aws" {
    region = "ap-south-1"
  
}
resource "aws_s3_bucket" "my_bucket" {
    bucket = "mahtab-terraform-day01-20260922"

    tags = {
      Name = "bucket-5.0"
      Environment = "Prod"
    }
}

========================================DAY 2++++++++++++++++++++++++++++++++++++++++
main.tf
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = "ap-south-1"
}

resource "aws_s3_bucket" "terraform_state" {
  bucket = "mahtab-terraform-state-20260929"

  tags = {
    Name        = "terraform-State"
    Environment = "Dev"
  }
}

resource "aws_s3_bucket_versioning" "terraform_state" {
  bucket = aws_s3_bucket.terraform_state.id

  versioning_configuration {
    status = "Enabled"
  }
}
--------------------------------backend.tf----------------------
terraform {
  backend "s3" {
    bucket       = "mahtab-terraform-state-20260929"
    key          = "dev/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
